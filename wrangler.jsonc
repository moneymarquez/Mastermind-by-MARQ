{
  // Cloudflare Workers config (unified "Workers with static assets" model).
  // Committed rather than left to Cloudflare's dashboard auto-detection so
  // the deploy always uses worker/index.ts (static assets + every /api/*
  // route, all served natively) instead of a static-assets-only fallback.
  "name": "mastermind-by-marq",
  "compatibility_date": "2026-08-08",
  // Needed for @anthropic-ai/sdk (the Stocks bot's 4:15pm Nova summary) to
  // run in the Workers runtime.
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  // Every deploy (including the automatic ones triggered by a git push)
  // otherwise replaces the Worker's whole variable/secret set with only
  // what's declared below — silently wiping out anything set manually in
  // the dashboard, like SUPABASE_SERVICE_ROLE_KEY or STRIPE_SECRET_KEY.
  // This was the real cause of the "I just set this in the dashboard and
  // now it's gone again" loop: it wasn't the dashboard failing to save,
  // it was the next deploy erasing it. Neither a `keep_vars` config field
  // here nor `wrangler deploy --keep-vars` actually preserved Secret-type
  // bindings (confirmed via the deploy log's bindings table — plain vars
  // survived, Secrets still vanished). The real fix lives in Cloudflare's
  // dashboard under Settings → Build configuration: the Deploy command
  // there now explicitly re-uploads STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // SUPABASE_SERVICE_ROLE_KEY, and VITE_STRIPE_PUBLISHABLE_KEY via
  // `wrangler secret bulk` (sourced from Cloudflare's own Build variables,
  // so nothing sensitive touches this repo) before every `wrangler deploy`.
  // ANTHROPIC_API_KEY was set by hand in the dashboard instead of being on
  // that list and got silently wiped on the next deploy (confirmed live —
  // "missing ANTHROPIC_API_KEY" errors from claude.ts). RESEND_API_KEY and
  // VAPID_PRIVATE_KEY are secrets in the exact same position right now —
  // required below, genuinely sensitive so they can't be committed here,
  // but ALSO NOT on the Deploy command's re-upload list — so client-login
  // emails (billing.ts), delivery emails (deliver-email.ts), the support
  // inbox's draft replies, and Opening/Closing push are all one deploy away
  // from silently going dark the same way. Add both to that list.
  // VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, and STRIPE_PRICE_ID are not
  // sensitive (the first two are already shipped in the built frontend
  // bundle, readable by anyone; a Stripe Price ID doesn't let anyone
  // charge anything, it just identifies which price to subscribe to), so
  // they're safe to commit here. This is a workaround for the Cloudflare
  // dashboard's Variables and Secrets form not persisting values reliably
  // when set manually (confirmed repeatedly via the Worker's live logs —
  // each one showed up correctly in the dashboard form but was still
  // missing at runtime) — declaring them here guarantees they're present
  // on every deploy regardless of dashboard state. SUPABASE_SERVICE_ROLE_KEY
  // and the remaining Stripe/Resend keys stay dashboard-only (Secrets) per
  // the note at the bottom of this file — those are genuinely sensitive.
  "vars": {
    // Where the email() handler forwards every inbound message after
    // storing it in the app's inbox — the same iCloud address the
    // Cloudflare Email Routing rules were forwarding to directly before
    // their action was switched to "Send to a Worker". Committed here
    // (not dashboard-only) on purpose: if this ever went missing, mail
    // would land in the app but stop reaching the mailbox, and the
    // dashboard-wipe-on-deploy behavior documented above would make that
    // happen silently. Must stay a verified Destination Address in
    // Cloudflare Email Routing.
    "INBOX_FORWARD_TO": "madebymarquez@icloud.com",
    "VITE_SUPABASE_URL": "https://jqkxaxjuvurciqmvnsbw.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Impxa3hheGp1dnVyY2lxbXZuc2J3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwNDE1ODAsImV4cCI6MjEwMTYxNzU4MH0.TjKqBJCBlqVQLXnQZIL6tyyGE3KEIdCdaa7FySOfOHA",
    "STRIPE_PRICE_ID": "price_1U6YjXRyuG1KPb7GE5a7AamS"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Two Cron Triggers, told apart by event.cron in worker/index.ts's
  // scheduled() export:
  //   */15 * * * * — Stocks bot engine (worker/handlers/stocks-bot.ts),
  //                  same cadence as it ran on Netlify; the handler itself
  //                  gates real work to market hours and the 4:15pm ET
  //                  summary window.
  //   */5  * * * * — Opening/Closing push reminders
  //                  (worker/handlers/shift-reminders.ts), same cadence as
  //                  the Netlify Scheduled Function it replaces.
  "triggers": {
    "crons": ["*/15 * * * *", "*/5 * * * *"]
  }
  // Required environment variables/secrets — set these in the Cloudflare
  // dashboard (Workers & Pages → mastermind-by-marq → Settings →
  // Variables and Secrets), NOT here, so nothing sensitive is committed:
  //   VITE_SUPABASE_URL          (plain variable)
  //   VITE_SUPABASE_ANON_KEY     (plain variable — already public in the built frontend)
  //   SUPABASE_SERVICE_ROLE_KEY  (secret)
  //   ANTHROPIC_API_KEY          (secret — optional; Nova commentary is skipped without it)
  //   STRIPE_SECRET_KEY          (secret — optional; billing gate shows "not configured" without it)
  //   STRIPE_PRICE_ID            (secret — the $19.99/mo recurring Price you create in your own Stripe dashboard)
  //   STRIPE_WEBHOOK_SECRET      (secret — from a webhook endpoint pointed at /api/billing/webhook)
  //   VITE_STRIPE_PUBLISHABLE_KEY (plain variable — used client-side to mount the Payment Element)
  //   RESEND_API_KEY             (secret — optional; "Send to client" shows "not configured" without it)
  //   RESEND_FROM_EMAIL          (plain variable — mastermindsbymarq.com sender, e.g. the client-login welcome email)
  //   MADEBYMARQUEZ_FROM_EMAIL   (plain variable — optional; madebymarquez.com sender for the client delivery/
  //                              invoice-summary email once that domain is verified in Resend — falls back to
  //                              RESEND_FROM_EMAIL until set, so nothing breaks in the meantime. The Client CRM
  //                              paid-invoice receipt (billing.ts's stripeWebhook, invoice.paid) uses a fixed
  //                              invoice@madebymarquez.com instead, not this var — needs that domain verified
  //                              in Resend, no separate config)
  //   RESEND_WEBHOOK_SECRET      (secret — optional; from Resend's Webhooks page, the email.received subscription)
  //   VITE_VAPID_PUBLIC_KEY      (plain variable — already public; same key the client already subscribes with,
  //                              needed here too since the Worker's own runtime env is separate from what Vite
  //                              baked into the built bundle at build time)
  //   VAPID_PRIVATE_KEY          (secret — signs the push JWT; reuse the SAME key pair Netlify already had, a new
  //                              one invalidates every existing subscription and forces everyone to re-subscribe)
  //   VAPID_SUBJECT              (plain variable — e.g. "mailto:you@yourdomain.com")
  //   STORE_TIMEZONE             (plain variable — IANA name, e.g. "America/Denver")
}
