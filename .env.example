VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — read by netlify/functions/claude.ts, never sent to the browser.
# Not prefixed with VITE_ on purpose: Vite would otherwise inline it into the client bundle.
ANTHROPIC_API_KEY=

# Web Push (Opening/Closing reminders while the app is fully closed) — see README
# "Web Push" setup section for where each of these comes from.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=
STORE_TIMEZONE=America/Chicago
