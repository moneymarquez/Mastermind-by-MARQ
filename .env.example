VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — read by the Cloudflare Worker (worker/handlers/claude.ts
# and worker/handlers/audit.ts), never sent to the browser. Not prefixed with
# VITE_ on purpose: Vite would otherwise inline it into the client bundle.
ANTHROPIC_API_KEY=

# Web Push (Opening/Closing reminders while the app is fully closed) — see README
# "Web Push" setup section for where each of these comes from.
# NOTE: subscriptions are still recorded, but scheduled pushes do not currently
# fire — the senders used the `web-push` npm package, which doesn't run in the
# Workers runtime, and have not been ported since Netlify was dropped.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=
STORE_TIMEZONE=America/Chicago

# Made by Marq public site (worker/handlers/audit.ts).
# Resend sends the "new lead" alert and the booking confirmation.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# IANA zone the booking slots are expressed in. Must be a zone name, not a
# fixed offset — booking_availability stores local wall-clock times and Sandy,
# UT observes DST. Separate from STORE_TIMEZONE above, which is unrelated.
BOOKING_TIMEZONE=America/Denver
# Optional: comma-separated extra origins allowed to call the public
# /api/audit/* and /api/booking/* routes, added to the defaults in
# worker/lib/http.ts. Needed only for preview deploys with generated hostnames.
PUBLIC_SITE_ORIGINS=
