VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — read by netlify/functions/claude.ts, never sent to the browser.
# Not prefixed with VITE_ on purpose: Vite would otherwise inline it into the client bundle.
ANTHROPIC_API_KEY=

# Web Push (Opening/Closing reminders while the app is fully closed) — see README
# "Web Push" setup section for where each of these comes from.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=
STORE_TIMEZONE=America/Chicago

# Sentry error monitoring (browser). Public DSN, baked in at build time.
# Leave empty locally: Sentry is skipped entirely when unset.
VITE_SENTRY_DSN=
# Worker-side Sentry reads the SENTRY_DSN Worker secret (wrangler secret put SENTRY_DSN); optional.
